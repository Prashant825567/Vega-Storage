# --------------------------------------------------------------------------- #
# Copy to .env.local for local runs. On Render these go in
# Environment → Environment Variables. Never commit a real session string.
# --------------------------------------------------------------------------- #

# --- credentials (REQUIRED, and the first three are secrets) --------------- #
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=replace_with_the_hash_from_my.telegram.org
# Produced by: python scripts/make_session.py
# Someone holding this string is signed in as the storage account. Rotate it by
# generating a new one and revoking the old session in the Telegram app.
TELEGRAM_SESSION=replace_with_the_string_from_make_session.py

# The key the admin panel and the app already send as `Authorization: Bearer …`.
# Same name the clients use, so nothing on either side changes.
ZENTRAGRID_API_KEY=replace_with_a_long_random_string

# --- the five channels (not secret; ids can be overridden per environment) -- #
# Defaults are the production ids, so a deploy needs nothing here.
# For a test environment, point these at the [TST] channels instead.
TELEGRAM_VAULT_ID=-1003597396903      # Vega Vault
TELEGRAM_AI_ID=-1004362809278         # Vega AI
TELEGRAM_SUPPORT_ID=-1004337129320    # Vega Support
TELEGRAM_NOTIFY_ID=-1003755323456     # Vega Notify
TELEGRAM_INDEX_ID=-1003960423150      # Vega Index

# --- routing --------------------------------------------------------------- #
# Which channel a collection's documents land in. Built-in defaults cover the
# collections that exist today; these override them one at a time.
# ZG_ROUTE_MESSAGES=tg.support.1
# ZG_ROUTE_CHAT_BROADCAST=tg.notify.1
# ZG_ROUTE_AI_CHATS=tg.ai.1

# Collections served by the hot store instead of a channel. Presence is the one
# that matters: a 20-second heartbeat per user does not fit in a chat's ~1 write
# per second, and forcing it there is how an account earns a flood wait.
ZG_HOT_COLLECTIONS=presence,typing,read_cursor

# Any collection with no route of its own lands here.
ZG_DEFAULT_COLLECTION_KEY=tg.support.1
# Where uploaded bytes go.
ZG_FILES_KEY=tg.vault.1

# --- behaviour ------------------------------------------------------------- #
# Telegram allows 4096 characters per message; 3000 leaves room for the header.
ZG_PART_CHARS=3000
ZG_CAPTION_PART_CHARS=800
# A page larger than this is refused with 400, exactly like ZentraGrid.
ZG_MAX_PAGE_LIMIT=200
# How much history a cold rebuild reads per channel.
ZG_SCAN_LIMIT=20000
# Minimum spacing between writes to one channel, in ms. 0 disables it; 1000 keeps
# a bulk import inside Telegram's ~1 write/second per chat guidance.
ZG_CHANNEL_MIN_INTERVAL_MS=0
# false = DELETE leaves a tombstone (the message id survives, the channel does not
# grow). true = DELETE removes the messages, and it cannot be undone.
ZG_HARD_DELETE=false
# Hot store snapshot. /tmp is ephemeral on Render — presence is meant to be.
ZG_HOT_SNAPSHOT=/tmp/vega-hot-store.json

LOG_LEVEL=INFO

# --- MTProto automatic recovery (optional; these are the defaults) ---------- #
# Timeouts are seconds. No new mandatory environment variables are required.
ZG_CONNECT_TIMEOUT_SECONDS=60
ZG_PROBE_INTERVAL_SECONDS=30
ZG_PROBE_TIMEOUT_SECONDS=15
ZG_RECONNECT_INITIAL_SECONDS=2
ZG_RECONNECT_MAX_SECONDS=60
# Raise this for very large channel histories; failed scans are retried.
ZG_REBUILD_TIMEOUT_SECONDS=600
